{
  "name": "gamehub-ipvg",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "web": "npm run dev --workspace frontend",
    "api": "npm start --workspace backend",
    "build:api": "npm run build --workspace backend",
    "build:web": "npm run build --workspace frontend",
    "build": "npm run build:api && npm run build:web",
    "test": "npm test --workspace backend",
    "seed": "npm run seed --workspace backend",
    "seed:admin": "npm run seed:admin --workspace backend"
  }
}
