{
  "name": "gamehub-ipvg",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "web": "vite web --host 127.0.0.1 --port 5173 --strictPort",
    "api": "npm run build:api && node --env-file=.env dist/main.js",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build web",
    "build": "npm run build:api && npm run build:web",
    "test": "npm run build:api && node --test",
    "seed": "npm run build:api && node --env-file=.env dist/seed.js",
    "seed:admin": "npm run build:api && node --env-file=.env dist/seed-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "mysql2": "^3.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "~0.3.28",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
